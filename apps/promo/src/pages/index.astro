              <li role="none"><a href="#architecture" role="menuitem" class="text-muted-foreground hover:text-foreground transition-colors text-sm font-medium">Architecture</a></li>
              <li role="none"><a href="#about" role="menuitem" class="text-muted-foreground hover:text-foreground transition-colors text-sm font-medium">About</a></li>
