              </svg>
              <span class="text-sm font-medium">Invite-only access while we manage LLM costs. Join the waitlist.</span>
            </div>
            <button
              type="button"
              onclick="window.openWaitlistModal?.()"
              class="group relative inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-orange-500 via-red-500 to-rose-600 text-white rounded-full font-semibold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300 overflow-hidden"
