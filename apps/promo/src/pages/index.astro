            <div class="absolute -inset-1 bg-gradient-to-r from-rose-600 to-pink-600 rounded-2xl opacity-10 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
            <article class="relative p-8 rounded-2xl border-2 border-border bg-card/50 backdrop-blur-sm hover:border-orange-200 dark:hover:border-orange-800 transition-all duration-300">
