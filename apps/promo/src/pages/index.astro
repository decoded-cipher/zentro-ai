                class="h-9 w-auto dark:hidden"
                width="144"
                height="36"
                loading="eager"
              />
              <img 
                src="/logo-white.png" 
                alt="Zentro AI - AI-Powered Website Builder" 
                class="h-9 w-auto hidden dark:block"
                width="144"
                height="36"
                loading="eager"
              />
            </a>
          </div>
          <div class="flex items-center gap-6">
            <ul class="hidden md:flex items-center space-x-8" role="menubar">
              <li role="none"><a href="#how-it-works" role="menuitem" class="text-muted-foreground hover:text-foreground transition-colors text-sm font-medium">How It Works</a></li>
              <li role="none"><a href="#demo" role="menuitem" class="text-muted-foreground hover:text-foreground transition-colors text-sm font-medium">Demo</a></li>
