---
import Layout from '../layouts/Layout.astro';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import WaitlistModal from '../components/WaitlistModal.astro';

// Get Turnstile site key from Cloudflare runtime or build env
const turnstileSiteKey = Astro.locals.runtime?.env?.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// Fetch GitHub repository data
const GITHUB_REPO = 'decoded-cipher/zentro-ai';
let githubData = {
  stars: 0,
  forks: 0,
  watchers: 0,
  openIssues: 0,
  error: false
};

if (import.meta.env.SSR) {
  try {
    const response = await fetch(`https://api.github.com/repos/${GITHUB_REPO}`, {
      headers: {
        'Accept': 'application/vnd.github+json',
        'User-Agent': 'Zentro-AI-Promo-Site'
      }
    });
    
    if (response.ok) {
      const data = await response.json();
      githubData = {
        stars: data.stargazers_count ?? 0,
        forks: data.forks_count ?? 0,
        watchers: data.watchers_count ?? 0,
        openIssues: data.open_issues_count ?? 0,
        error: false
      };
    } else {
      githubData.error = true;
    }
  } catch (error) {
    githubData.error = true;
  }
}
---

<Layout 
  title="Zentro AI - AI-Powered Website Builder"
  description="Build websites instantly with AI. Describe your vision in plain English and watch Zentro AI generate fully functional websites with live preview, code editor, and instant download."
>
