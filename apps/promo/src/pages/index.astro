                <span class="font-medium">AI-powered website builder</span>
              </div>
            </div>
          </div>

          <!-- Main Heading -->
          <div class="text-center space-y-4">
            <h1 id="hero-title" class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground leading-tight">
              Build Websites with
              <span class="relative inline-block">
                <span class="relative z-10 bg-gradient-to-r from-orange-400 via-red-600 to-rose-600 bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
                  Just Words
                </span>
                <span class="absolute inset-0 bg-orange-400/20 blur-2xl animate-pulse-glow" aria-hidden="true"></span>
              </span>
            </h1>
            <p class="text-lg md:text-xl text-foreground/70 max-w-2xl mx-auto font-normal">
              Describe your idea in natural language, and watch as AI generates a fully functional website with live preview, code editor, and instant deployment.
            </p>
          </div>
          
          <!-- Waitlist CTA - Invite only due to LLM costs -->
          <div class="flex flex-col items-center gap-6">
            <div class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-accent/10 border border-accent/20 text-accent">
